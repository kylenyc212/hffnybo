# Copy to .env.local and fill in real values. NEVER commit .env.local.

# === Public (browser) ===
VITE_SUPABASE_URL=https://gndzlimjgqwdcohmpkty.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# === Server-only (Vercel env vars; do NOT prefix with VITE_) ===
# Set in Vercel Dashboard → Settings → Environment Variables.
# Wix credentials for /api/wix-events and /api/wix-sync:
WIX_API_KEY=your-wix-api-key
WIX_ACCOUNT_ID=your-wix-account-id
WIX_SITE_ID=your-wix-site-id

# Cron secret — Vercel cron auto-attaches `Authorization: Bearer ${CRON_SECRET}`
# when this is set. Generate with `openssl rand -hex 32`.
CRON_SECRET=long-random-string-here

# Service role key for the cron-driven /api/wix-sync to write to the DB
# without going through RLS. From Supabase Dashboard → API → service_role.
SUPABASE_URL=https://gndzlimjgqwdcohmpkty.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
